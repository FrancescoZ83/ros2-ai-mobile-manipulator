<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Test payload rigidly attached at the TCP (simulation only).
       Point-like on purpose: tiny inertia and no collision, so it only adds mass. -->
  <xacro:property name="payload_mass" value="$(arg payload_mass)"/>

  <xacro:if value="${payload_mass > 0.0}">
    <link name="payload_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${payload_mass}"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual>
        <geometry>
          <sphere radius="0.03"/>
        </geometry>
        <material name="payload_orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
    </link>
    <joint name="payload_joint" type="fixed">
      <parent link="gripper_tcp"/>
      <child link="payload_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

</robot>
