<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="lidar_body"><color rgba="0.1 0.1 0.12 1"/></material>

  <!-- 2D LiDAR modeled as a simple cylinder (approximate size of a compact planar scanner).
       The link frame is the scan frame used later by SLAM and Nav2. -->
  <xacro:macro name="lidar_2d" params="name:=lidar parent *origin radius:=0.03 height:=0.05 mass:=0.15">
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_link"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <geometry><cylinder radius="${radius}" length="${height}"/></geometry>
        <material name="lidar_body"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${radius}" length="${height}"/></geometry>
      </collision>
      <!-- Solid cylinder with its axis along z -->
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${mass*(3*radius*radius+height*height)/12}" ixy="0" ixz="0"
                 iyy="${mass*(3*radius*radius+height*height)/12}" iyz="0"
                 izz="${mass*radius*radius/2}"/>
      </inertial>
    </link>
  </xacro:macro>
</robot>
