<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="gripper_grey"><color rgba="0.55 0.55 0.58 1"/></material>
  <material name="gripper_dark"><color rgba="0.15 0.15 0.15 1"/></material>

  <xacro:macro name="gripper_box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${mass*(x*x+z*z)/12}" iyz="0"
               izz="${mass*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- side: 1 = finger at +y, -1 = finger at -y. Position 0 = open, positive = closes -->
  <xacro:macro name="gripper_finger" params="prefix name side y_open z_pos size_x thickness length mass travel">
    <link name="${prefix}${name}_finger_link">
      <visual>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><box size="${size_x} ${thickness} ${length}"/></geometry>
        <material name="gripper_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
        <geometry><box size="${size_x} ${thickness} ${length}"/></geometry>
      </collision>
      <xacro:gripper_box_inertial mass="${mass}" x="${size_x}" y="${thickness}" z="${length}">
        <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
      </xacro:gripper_box_inertial>
    </link>
    <joint name="${prefix}${name}_finger_joint" type="prismatic">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${name}_finger_link"/>
      <origin xyz="0 ${side*y_open} ${z_pos}" rpy="0 0 0"/>
      <axis xyz="0 ${-side} 0"/>
      <limit lower="0" upper="${travel}" effort="100" velocity="0.2"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="parallel_gripper" params="
      prefix:=gripper_ parent *origin
      palm_x:=0.06 palm_y:=0.11 palm_z:=0.06 palm_mass:=0.5
      finger_x:=0.02 finger_thickness:=0.012 finger_length:=0.06 finger_mass:=0.1
      max_opening:=0.085 travel:=0.04 tcp_offset:=0.05">

    <joint name="${prefix}mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>

    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 ${palm_z/2}" rpy="0 0 0"/>
        <geometry><box size="${palm_x} ${palm_y} ${palm_z}"/></geometry>
        <material name="gripper_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${palm_z/2}" rpy="0 0 0"/>
        <geometry><box size="${palm_x} ${palm_y} ${palm_z}"/></geometry>
      </collision>
      <xacro:gripper_box_inertial mass="${palm_mass}" x="${palm_x}" y="${palm_y}" z="${palm_z}">
        <origin xyz="0 0 ${palm_z/2}" rpy="0 0 0"/>
      </xacro:gripper_box_inertial>
    </link>

    <xacro:gripper_finger prefix="${prefix}" name="left" side="1"
      y_open="${max_opening/2 + finger_thickness/2}" z_pos="${palm_z}"
      size_x="${finger_x}" thickness="${finger_thickness}" length="${finger_length}"
      mass="${finger_mass}" travel="${travel}"/>
    <xacro:gripper_finger prefix="${prefix}" name="right" side="-1"
      y_open="${max_opening/2 + finger_thickness/2}" z_pos="${palm_z}"
      size_x="${finger_x}" thickness="${finger_thickness}" length="${finger_length}"
      mass="${finger_mass}" travel="${travel}"/>

    <!-- Tool Center Point: half between fingers, center of grip -->
    <link name="${prefix}tcp"/>
    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}tcp"/>
      <origin xyz="0 0 ${palm_z + tcp_offset}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
