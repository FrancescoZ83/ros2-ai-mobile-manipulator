<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm_test">
  <xacro:include filename="$(find amr_manipulator_description)/urdf/arm/ur_macro.xacro"/>
  <xacro:property name="ur_cfg" value="$(find amr_manipulator_description)/config/arm/ur5e"/>

  <link name="base_link"/>   <!-- temp -->

  <xacro:ur_robot
    name="ur5e"
    tf_prefix="ur_"
    parent="base_link"
    joint_limits_parameters_file="${ur_cfg}/joint_limits.yaml"
    kinematics_parameters_file="${ur_cfg}/default_kinematics.yaml"
    physical_parameters_file="${ur_cfg}/physical_parameters.yaml"
    visual_parameters_file="${ur_cfg}/visual_parameters.yaml"
    ur_type="ur5e"
    generate_ros2_control_tag="false">
    <origin xyz="0.2 0 0.35" rpy="0 0 0"/>
  </xacro:ur_robot>
</robot>
