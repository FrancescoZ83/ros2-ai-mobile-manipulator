<?xml version="1.0"?>
<!--
  Fetch an article from a shelf slot and put it in a bin of the packing table.
  The blackboard has slot, article_class, bin and alt_bin (parameters of mission_executor); every skill writes its outcome to a key
  (nav_outcome, pick_outcome, carry_outcome, place_outcome, final_outcome). A SubTree of BehaviorTree.CPP 3 maps the keys of its own scope
  to keys of the parent with the name of the parent's key WITHOUT braces (target_slot="slot"); with braces the port stayed empty.
    - the drive to the shelf is tried twice;
    - the pick is tried three times: again as it is, then after opening the gripper and stowing the arm, then after driving to
      the station again (which also refreshes the localization);
    - the article is carried (attached to the TCP in the planning scene, arm at the travel pose) and its presence is checked;
    - the bin: the first one; if the drive or the placing fails, the arm goes back to the travel pose with the article and the
      other bin is tried;
    - whatever happens, the arm ends in a safe state.
-->
<root main_tree_to_execute="Mission">
  <BehaviorTree ID="Mission">
    <Fallback name="safe_end">
      <Sequence name="fetch_and_deliver">
        <RetryUntilSuccessful num_attempts="2">
          <NavigateTo place="{slot}" outcome="{nav_outcome}"/>
        </RetryUntilSuccessful>
        <SubTree ID="PickWithRecovery" target_slot="slot" target_class="article_class" pick_result="pick_outcome"/>
        <CarryArticle speed_scale="0.25" outcome="{carry_outcome}"/>
        <SubTree ID="DeliverWithFallback" first_bin="bin" second_bin="alt_bin" place_result="place_outcome"/>
        <Recover what="stow" outcome="{final_outcome}"/>
      </Sequence>
      <Sequence name="give_up">
        <Recover what="release_and_stow" outcome="{final_outcome}"/>
        <AlwaysFailure/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="PickWithRecovery">
    <Fallback name="pick_tries">
      <PickArticle slot="{target_slot}" article_class="{target_class}" outcome="{pick_result}"/>
      <Sequence name="again">
        <Recover what="release_and_stow"/>
        <PickArticle slot="{target_slot}" article_class="{target_class}" outcome="{pick_result}"/>
      </Sequence>
      <Sequence name="again_from_the_station">
        <Recover what="release_and_stow"/>
        <NavigateTo place="{target_slot}"/>
        <PickArticle slot="{target_slot}" article_class="{target_class}" outcome="{pick_result}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="DeliverWithFallback">
    <Fallback name="bins">
      <Sequence name="first_bin">
        <NavigateTo place="{first_bin}"/>
        <PlaceInBin bin="{first_bin}" outcome="{place_result}"/>
      </Sequence>
      <Sequence name="other_bin">
        <CarryArticle speed_scale="0.25"/>
        <NavigateTo place="{second_bin}"/>
        <PlaceInBin bin="{second_bin}" outcome="{place_result}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>
