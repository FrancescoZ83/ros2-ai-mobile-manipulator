<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="grasp_box">
    <link name="link">
      <!-- 1 kg box 40 x 60 x 60 mm (60 mm along y, the closing direction after the wrist turn) -->
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>6.0e-4</ixx>
          <iyy>4.3333e-4</iyy>
          <izz>4.3333e-4</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.04 0.06 0.06</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.04 0.06 0.06</size></box></geometry>
        <material>
          <ambient>0.9 0.5 0.1 1</ambient>
          <diffuse>0.9 0.5 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>