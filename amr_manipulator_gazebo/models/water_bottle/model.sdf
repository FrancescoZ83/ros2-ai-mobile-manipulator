<?xml version="1.0"?>
<sdf version="1.8">
  <model name="water_bottle">
    <link name="link">
      <!-- The model origin is the centre of the base: the body is lifted by half its height -->
      <pose>0 0 0.0900 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0008775</ixx><iyy>0.0008775</iyy><izz>0.000135</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.03</radius><length>0.18</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.03</radius><length>0.18</length></cylinder></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://water_bottle/materials/textures/water_bottle.png</albedo_map>
              <roughness>0.8</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
